      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Lato:wght@400;700&display=swap');\n\n:root{\n  --ink:#15181c;\n  --ink-2:#40464e;\n  --muted:#717a85;\n  --line:#e5e5df;\n  --line-strong:#d6d6cf;\n  --paper:#ffffff;\n  --rail:#f7f7f4;\n  --rail-hover:#ecece6;\n  --rail-active:#e6e6df;\n  --accent:#14544d;\n  --accent-soft:#edf4f2;\n  --warn:#8a5400;\n  --warn-soft:#fdf6e9;\n}\n*{box-sizing:border-box}\nhtml,body{height:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:'Lato',system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}\nbutton{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}\nbutton:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.icon{display:inline-flex;align-items:center;justify-content:center;flex:none}\n.icon svg{width:16px;height:16px;stroke-width:1.75}\n.app{display:flex;height:100vh;overflow:hidden;background:var(--paper)}\n\n/* ---------- sidebar ---------- */\n.rail{width:260px;flex:none;background:var(--rail);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:0 12px 14px;overflow:hidden}\n.rail-top{height:72px;flex:none;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:5px;padding:0 4px}\n.brand{display:flex;align-items:center;gap:9px;font-family:'Archivo';font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--ink);text-decoration:none}\n.mark{width:26px;height:26px;border-radius:7px;background:var(--ink);color:#fff;display:grid;place-items:center}\n.mark svg{width:15px;height:15px;stroke-width:1.9}\n.ws-toggle{display:inline-flex;align-items:center;gap:4px;height:20px;margin-left:35px;font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--muted)}\n.ws-toggle:hover{color:var(--ink)}\n.ws-toggle svg{width:13px;height:13px;stroke-width:2}\n.new-chat{display:flex;align-items:center;gap:9px;height:40px;flex:none;padding:0 11px;border-radius:8px;font-family:'Archivo';font-size:13.5px;font-weight:500;color:var(--ink);width:100%;border:1px solid var(--line-strong);background:#fff;margin-top:2px}\n.new-chat:hover{background:#fcfcfa;border-color:#c3c6bd}\n.new-chat .icon svg{width:15px;height:15px;stroke-width:2}\n.nav{display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;padding-top:20px;flex:1;min-height:0}\n.nav::-webkit-scrollbar{width:0}\n.nav-label{display:flex;align-items:center;justify-content:space-between;padding:0 10px;margin-bottom:6px;font-family:'Archivo';font-size:11.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:#8a929b}\n.nav-label .count{font-size:11.5px;font-weight:600;color:var(--muted);letter-spacing:0}\n.nav-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px}\n.row{display:flex;align-items:center;gap:9px;width:100%;height:38px;padding:0 10px;border-radius:7px;text-align:left;font-family:'Archivo';font-size:13.5px;font-weight:400;color:var(--ink-2)}\n.row:hover{background:var(--rail-hover);color:var(--ink)}\n.row.is-active{background:var(--rail-active);color:var(--ink);font-weight:500}\n.row .t{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.row .meta{font-size:12px;font-weight:400;color:var(--muted);flex:none}\n.row .icon svg{width:15px;height:15px;stroke-width:1.6;color:var(--muted)}\n.row.is-active .icon svg{color:var(--ink-2)}\n.docs{margin-top:20px}\n.add-docs{display:flex;align-items:center;gap:9px;width:100%;height:38px;padding:0 10px;margin-top:4px;border-radius:7px;font-family:'Archivo';font-size:13.5px;font-weight:500;color:var(--inks,var(--ink-2))}\n.add-docs:hover{background:var(--rail-hover);color:var(--ink)}\n.add-docs .icon svg{width:15px;height:15px;stroke-width:1.8}\n\n/* ---------- main ---------- */\n.main{position:relative;flex:1;min-width:0;display:flex;flex-direction:column}\n.thread-head{height:72px;flex:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 18px 0 31px;border-bottom:1px solid var(--line);background:var(--paper)}\n.thread-head h1{margin:0;font-family:'Archivo';font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--ink)}\n.head-actions{display:flex;align-items:center;gap:4px}\n.icon-btn{width:34px;height:34px;border-radius:7px;display:grid;place-items:center;color:var(--muted)}\n.icon-btn:hover{background:#f2f2ee;color:var(--ink)}\n.icon-btn svg{width:17px;height:17px;stroke-width:1.7}\n\n.thread{flex:1;min-height:0;overflow-y:auto;margin-right:420px}\n.thread-inner{max-width:720px;margin:0 auto;padding:28px 20px 16px}\n.user-row{display:flex;justify-content:flex-end;margin:0 0 22px}\n.bubble{max-width:540px;padding:10px 16px;border-radius:16px 16px 5px 16px;background:#f1f1ec;font-size:15px;line-height:1.5;color:#1b1f24}\n.turn{margin-bottom:32px}\n.answer{font-size:16px;line-height:1.66;color:#20242a}\n.answer p{margin:0 0 14px}\n.answer p:last-child{margin-bottom:0}\n.cite{display:inline-flex;align-items:center;justify-content:center;min-width:17px;height:17px;padding:0 4px;margin:0 0 0 2px;border-radius:4px;background:var(--accent-soft);color:var(--accent);font-family:'Archivo';font-size:11px;font-weight:600;line-height:1;vertical-align:1.5px;border:1px solid transparent;transition:background .12s ease}\n.cite:hover{border-color:#adc8c3}\n.cite.is-selected{background:var(--accent);border-color:var(--accent);color:#fff}\n.answer-foot{display:flex;align-items:center;gap:4px;height:40px;margin-top:8px}\n.foot-btn{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 9px;border-radius:6px;font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--muted)}\n.foot-btn:hover{background:#f3f3ef;color:var(--ink)}\n.foot-btn .icon svg{width:14px;height:14px;stroke-width:1.8}\n.foot-btn.is-open{color:var(--ink);background:#f3f3ef}\n.foot-sep{width:1px;height:13px;background:var(--line-strong);margin:0 2px}\n\n/* ---------- composer ---------- */\n.composer{flex:none;padding:12px 20px 18px;margin-right:420px;background:var(--paper)}\n.composer-inner{max-width:720px;margin:0 auto}\n.field{display:flex;align-items:flex-end;gap:8px;height:76px;padding:10px 10px 10px 12px;border:1px solid var(--line-strong);border-radius:14px;background:#fff;box-shadow:0 1px 2px rgba(20,24,28,.04)}\n.field:focus-within{border-color:#9daeaa;box-shadow:0 0 0 3px rgba(20,84,77,.09)}\n.field textarea{flex:1;height:44px;padding:6px 2px;border:0;outline:0;resize:none;background:transparent;font-family:'Lato';font-size:15px;line-height:1.5;color:var(--ink)}\n.field textarea::placeholder{color:#8b939b}\n.attach{width:32px;height:32px;border-radius:7px;display:grid;place-items:center;color:var(--muted)}\n.attach:hover{background:#f3f3ef;color:var(--ink)}\n.attach svg{width:17px;height:17px;stroke-width:1.7}\n.send{width:44px;height:44px;flex:none;border-radius:10px;display:grid;place-items:center;background:var(--ink);color:#fff}\n.send:hover{background:#000}\n.send svg{width:19px;height:19px;stroke-width:2}\n\n/* ---------- source slide-over ---------- */\n.drawer{position:absolute;top:72px;right:0;bottom:0;width:420px;display:flex;flex-direction:column;background:#fff;border-left:1px solid var(--line);box-shadow:-20px 0 44px -30px rgba(16,24,40,.3);z-index:5}\n.drawer-head{height:64px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 14px 0 20px;border-bottom:1px solid var(--line)}\n.drawer-head h2{margin:0;font-family:'Archivo';font-size:14.5px;font-weight:600}\n.drawer-head .count{font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--muted);margin-left:8px}\n.close{width:30px;height:30px;border-radius:6px;display:grid;place-items:center;color:var(--muted)}\n.close:hover{background:#f2f2ee;color:var(--ink)}\n.close svg{width:17px;height:17px}\n.drawer-body{flex:1;min-height:0;overflow-y:auto;padding:22px 20px 24px}\n.src-head{display:flex;align-items:flex-start;gap:10px;padding-bottom:16px}\n.src-head .icon svg{width:18px;height:18px;stroke-width:1.7;color:var(--ink-2);margin-top:1px}\n.src-name{font-family:'Archivo';font-size:14.5px;font-weight:600;line-height:1.35;color:var(--ink);word-break:break-word}\n.src-meta{margin-top:3px;font-size:12.5px;color:var(--muted)}\n.quote{margin:0;padding:0 0 0 14px;border-left:2px solid #cfe0dc;font-size:14.5px;line-height:1.62;color:#2b3138}\n.excerpt{margin-top:18px;padding:14px;border:1px solid var(--line);border-radius:10px;background:#f8f8f5;font-size:13.5px;line-height:1.68;color:#3c424a}\n.excerpt p{margin:0}\n.section{margin-top:24px}\n.sec-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px}\n.sec-head h3{margin:0;font-family:'Archivo';font-size:12.5px;font-weight:600;color:var(--ink)}\n.sec-head span{font-family:'Archivo';font-size:12px;color:var(--muted)}\n.cite-row{display:flex;align-items:flex-start;gap:10px;width:100%;padding:10px 8px;border-radius:7px;text-align:left}\n.cite-row:hover{background:#f5f5f1}\n.cite-row .num{display:grid;place-items:center;min-width:18px;height:18px;margin-top:1px;border-radius:4px;background:var(--accent-soft);color:var(--accent);font-family:'Archivo';font-size:11px;font-weight:600;flex:none}\n.cite-row.is-selected .num{background:var(--accent);color:#fff}\n.cite-row .name{display:block;font-family:'Archivo';font-size:13px;font-weight:500;color:var(--ink);line-height:1.4;word-break:break-word}\n.cite-row .loc{display:block;margin-top:2px;font-size:12px;color:var(--muted)}\n.safety{margin-top:22px;border-top:1px solid var(--line);padding-top:16px}\n.safety-head{display:flex;align-items:center;justify-content:space-between;width:100%;height:28px}\n.safety-head .label{display:flex;align-items:center;gap:7px;font-family:'Archivo';font-size:12.5px;font-weight:600;color:var(--ink)}\n.safety-head .label svg{width:14px;height:14px;stroke-width:1.8;color:var(--ink-2)}\n.safety-head .chev{color:var(--muted)}\n.safety-head .chev svg{width:14px;height:14px}\n.safety-body{margin-top:6px}\n.safety-row{display:grid;grid-template-columns:96px 1fr;gap:10px;padding:7px 0;border-bottom:1px solid #f0f0ec;font-size:12.5px;line-height:1.55}\n.safety-row:last-child{border-bottom:0}\n.safety-row dt{color:var(--muted)}\n.safety-row dd{margin:0;color:var(--ink-2)}\n.conf{display:inline-flex;align-items:center;gap:5px;color:#7a5a12}\n.conf:before{content:\"\";width:5px;height:5px;border-radius:50%;background:#b98a1f}\n.note{padding:10px 12px;margin-top:8px;border-radius:8px;background:var(--warn-soft);color:#5f4410;font-size:12.5px;line-height:1.55}\n.drawer-foot{height:56px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 20px;border-top:1px solid var(--line)}\n.open-doc{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border-radius:7px;font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--ink);border:1px solid var(--line-strong)}\n.open-doc:hover{background:#f6f6f2}\n.open-doc svg{width:14px;height:14px;stroke-width:1.8;color:var(--muted)}\n.drawer-foot .page{font-family:'Archivo';font-size:12px;color:var(--muted)}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout container\">\n<aside class=\"rail\" data-kid=\"1-1\" data-name=\"sidebar with workspace navigation\">\n<div class=\"rail-top\" data-kid=\"1-1-1\" data-name=\"sidebar header section\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and wordmark link\" href=\"#\"><span class=\"mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo badge\"><span class=\"icon\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-1-1-1-1-1\" data-lucide=\"file-text\" data-name=\"document text logo icon\" data-reason=\"icon element replaced with SVG by lucide.createIcons() script\"></i></span></span>AnchorDocs</a>\n<button aria-label=\"Switch workspace\" class=\"ws-toggle\" data-k