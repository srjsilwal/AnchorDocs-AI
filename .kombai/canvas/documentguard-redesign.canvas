      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19447/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/documentguard-redesign.canvas\", nodeId: \"var_c_library_sidebar\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Lato:wght@400;700&display=swap');\n\n:root{\n  --ink:#15181c;\n  --ink-2:#40464e;\n  --muted:#717a85;\n  --line:#e5e5df;\n  --line-strong:#d6d6cf;\n  --paper:#ffffff;\n  --rail:#f7f7f4;\n  --rail-hover:#ecece6;\n  --rail-active:#e6e6df;\n  --accent:#14544d;\n  --accent-soft:#edf4f2;\n  --warn:#8a5400;\n  --warn-soft:#fdf6e9;\n}\n*{box-sizing:border-box}\nhtml,body{height:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:'Lato',system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}\nbutton,input,textarea{font:inherit;color:inherit}\nbutton{background:none;border:0;padding:0;cursor:pointer}\nbutton:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.icon{display:inline-flex;align-items:center;justify-content:center;flex:none}\n.icon svg{width:16px;height:16px;stroke-width:1.75}\n\n.app{display:flex;height:100vh;overflow:hidden;background:var(--paper)}\n\n/* ================= sidebar ================= */\n.rail{width:304px;flex:none;background:var(--rail);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:0 14px 14px;overflow:hidden}\n.rail-workspace{height:72px;flex:none;display:flex;flex-direction:column;justify-content:center;gap:4px;padding:0 2px}\n.brand{display:flex;align-items:center;gap:9px;font-family:'Archivo';font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--ink);text-decoration:none}\n.mark{width:26px;height:26px;border-radius:7px;background:var(--ink);color:#fff;display:grid;place-items:center;flex:none}\n.mark svg{width:15px;height:15px;stroke-width:1.9}\n.ws-toggle{display:inline-flex;align-items:center;gap:4px;align-self:flex-start;height:20px;margin-left:35px;font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--muted)}\n.ws-toggle:hover{color:var(--ink)}\n.ws-toggle svg{width:13px;height:13px;stroke-width:2}\n.new-chat{display:flex;align-items:center;gap:9px;width:100%;height:40px;flex:none;margin-top:2px;padding:0 10px;border-radius:7px;font-family:'Archivo';font-size:13.5px;font-weight:500;color:var(--ink-2)}\n.new-chat:hover{background:var(--rail-hover);color:var(--ink)}\n.new-chat .icon svg{width:16px;height:16px;stroke-width:1.9;color:#6f7780}\n.new-chat:hover .icon svg{color:var(--ink)}\n\n.nav{flex:1;min-height:0;display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;padding:20px 0 0}\n.nav::-webkit-scrollbar{width:0}\n.section-label{display:flex;align-items:center;gap:5px;width:100%;height:24px;padding:0 10px;margin-bottom:4px;text-align:left}\n.section-label .label{font-family:'Archivo';font-size:11.5px;font-weight:600;letter-spacing:.045em;text-transform:uppercase;color:#8a929b}\n.section-label .count{margin-left:auto;font-family:'Archivo';font-size:11.5px;font-weight:600;letter-spacing:0;color:var(--muted)}\n.section-label .chev{display:inline-flex;color:#9aa1a9;transition:transform .15s ease}\n.section-label .chev svg{width:13px;height:13px;stroke-width:2}\n.section-label:hover .label,.section-label:hover .chev{color:var(--ink-2)}\n.section-label.is-collapsed .chev{transform:rotate(-90deg)}\n.section-label + .section-label{margin-top:18px}\n\n.rows{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px}\n.row{display:flex;align-items:center;gap:9px;width:100%;height:36px;padding:0 10px;border-radius:6px;text-align:left;font-family:'Archivo';font-size:13.5px;font-weight:400;color:var(--ink-2)}\n.row:hover{background:var(--rail-hover);color:var(--ink)}\n.row.is-active{background:var(--rail-active);color:var(--ink);font-weight:500}\n.row .name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.row .pages{flex:none;font-family:'Archivo';font-size:12px;font-weight:400;color:var(--muted);font-variant-numeric:tabular-nums}\n.row .icon svg{width:15px;height:15px;stroke-width:1.6;color:#7d858e}\n.row:hover .icon svg,.row.is-active .icon svg{color:var(--ink-2)}\n.row-doc{height:36px}\n.row-doc .name{font-size:13px}\n.show-all{display:flex;align-items:center;gap:6px;width:100%;height:32px;padding:0 10px;margin-top:2px;border-radius:6px;font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--muted)}\n.show-all:hover{background:var(--rail-hover);color:var(--ink)}\n.show-all .icon svg{width:13px;height:13px;stroke-width:2}\n\n.docs{display:flex;flex-direction:column;margin-top:18px;min-height:0}\n.search{position:relative;flex:none;height:40px;margin:2px 0 6px}\n.search .icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);pointer-events:none;color:#8b939b}\n.search .icon svg{width:15px;height:15px;stroke-width:1.8}\n.search input{width:100%;height:40px;padding:0 10px 0 33px;border:1px solid var(--line-strong);border-radius:8px;background:#fff;font-family:'Lato';font-size:13px;color:var(--ink)}\n.search input::placeholder{color:#8b939b}\n.search input:hover{border-color:#c3c6bd}\n.docs .rows{overflow-y:auto;min-height:0}\n.docs .rows::-webkit-scrollbar{width:0}\n.add-docs{display:flex;align-items:center;gap:9px;width:100%;height:36px;flex:none;margin-top:6px;padding:0 10px;border-radius:6px;font-family:'Archivo';font-size:13px;font-weight:500;color:var(--ink-2)}\n.add-docs:hover{background:var(--rail-hover);color:var(--ink)}\n.add-docs .icon svg{width:15px;height:15px;stroke-width:1.8;color:#7d858e}\n\n/* ================= main ================= */\n.main{flex:1;min-width:0;display:flex;flex-direction:column;background:var(--paper)}\n.thread-head{height:72px;flex:none;display:flex;align-items:center;padding:0 31px;border-bottom:1px solid var(--line)}\n.thread-head h1{margin:0;font-family:'Archivo';font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n\n.thread{flex:1;min-height:0;overflow-y:auto}\n.thread-inner{max-width:720px;margin:0 auto;padding:32px 31px 8px}\n.turn{margin-bottom:32px}\n.turn:last-child{margin-bottom:8px}\n.user-row{display:flex;justify-content:flex-end;margin-bottom:22px}\n.bubble{max-width:520px;padding:10px 16px;border-radius:16px 16px 5px 16px;background:#f1f1ec;font-size:15px;line-height:1.5;color:#1b1f24}\n.answer{font-family:'Lato';font-size:16px;line-height:1.66;color:#20242a}\n.answer p{margin:0}\n.cite{display:inline-flex;align-items:center;justify-content:center;min-width:16px;height:16px;padding:0 2px;margin:0 -1px 0 2px;border-radius:4px;background:var(--accent-soft);border:1px solid transparent;color:var(--accent);font-family:'Archivo';font-size:11px;font-weight:600;line-height:1;vertical-align:1.5px;transition:background .12s ease,border-color .12s ease}\n.cite:hover{background:#dfece9;border-color:#b7cfc9;color:#0d3b36}\n.cite:focus-visible{outline-offset:1px}\n.answer-foot{display:flex;align-items:center;gap:2px;height:40px;margin-top:10px}\n.foot-btn{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 9px;border-radius:6px;font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--muted)}\n.foot-btn:hover{background:#f3f3ef;color:var(--ink)}\n.foot-btn .icon svg{width:14px;height:14px;stroke-width:1.8}\n.foot-sep{width:1px;height:13px;flex:none;background:var(--line-strong);margin:0 3px}\n.conf-tag{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 9px;font-family:'Archivo';font-size:12.5px;font-weight:500;color:var(--muted)}\n.conf-tag:before{content:\"\";width:6px;height:6px;border-radius:50%;background:#b98a1f;flex:none}\n\n/* ================= composer ================= */\n.composer{flex:none;padding:12px 31px 18px;background:var(--paper)}\n.composer-inner{max-width:720px;margin:0 auto}\n.field{display:flex;align-items:center;gap:8px;height:76px;padding:0 10px 0 10px;border:1px solid var(--line-strong);border-radius:14px;background:#fff;box-shadow:0 1px 2px rgba(20,24,28,.04)}\n.field:focus-within{border-color:#a8b8b4;box-shadow:0 0 0 3px rgba(20,84,77,.08)}\n.attach{width:32px;height:32px;flex:none;border-radius:7px;display:grid;place-items:center;color:var(--muted)}\n.attach:hover{background:#f3f3ef;color:var(--ink)}\n.attach .icon svg{width:17px;height:17px;stroke-width:1.7}\n.field textarea{flex:1;min-width:0;height:44px;padding:12px 2px;border:0;outline:0;background:transparent;resize:none;font-family:'Lato';font-size:15px;line-height:1.5;color:var(--ink)}\n.field textarea::placeholder{color:#8b939b}\n.send{width:44px;height:44px;flex:none;border-radius:10px;display:grid;place-items:center;background:var(--ink);color:#fff}\n.send:hover{background:#000}\n.send .icon svg{width:19px;height:19px;stroke-width:2}\n.send:disabled{background:#d6d6cf;color:#8b939b;cursor:not-allowed}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout container\">\n<aside aria-label=\"Workspace navigation\" class=\"rail\" data-kid=\"1-1\" data-name=\"workspace navigation sidebar\">\n<div class=\"rail-workspace\" data-kid=\"1-1-1\" data-name=\"sidebar workspace header section\">\n<a aria-label=\"AnchorDocs home\" class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\"><span class=\"mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand mark badge\"><span class=\"icon\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand mark icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-1-1-1-1-1\" data-lucide=\"file-text\" data-name=\"document file icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span></span>AnchorDocs</a>\n<button aria-label=\"Switch workspace, Procurement\" class=\"ws-toggle\" data-kid=\"1-1-1-2\" data-name=\"workspace switcher button\" type=\"button\">Procurement<span class=\"icon\" data-kid=\"1-1-1-2-1\" data-name=\"workspace drodown chevron wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span></button>\n</div>\n<button class=\"new-chat\" data-kid=\"1-1-2\" data-name=\"new chat button\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-2-1\" data-name=\"new chat plus icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-2-1-1\" data-lucide=\"plus\" data-name=\"plus icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>New chat</button>\n<nav class=\"nav\" data-kid=\"1-1-3\" data-name=\"sidebar navigation container\">\n<button aria-expanded=\"false\" class=\"section-label is-collapsed\" data-kid=\"1-1-3-1\" data-name=\"recent conversations section header\" type=\"button\">\n<span class=\"chev\" data-kid=\"1-1-3-1-1\" data-name=\"section collapse chevron wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-1-1-1\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>\n<span class=\"label\" data-kid=\"1-1-3-1-2\" data-name=\"section label text\">Recent conversations</span>\n<span class=\"count\" data-kid=\"1-1-3-1-3\" data-name=\"conversation count badge\">8</span>\n</button>\n<ul class=\"rows\" data-kid=\"1-1-3-2\" data-name=\"recent conversations list\">\n<li data-kid=\"1-1-3-2-1\" data-name=\"active conversation list item\"><button aria-current=\"page\" class=\"row is-active\" data-kid=\"1-1-3-2-1-1\" data-name=\"active conversation row button\" type=\"button\"><span class=\"name\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"conversation title text\">Liability cap in Cascade MSA</span></button></li>\n<li data-kid=\"1-1-3-2-2\" data-name=\"conversation list item\"><button class=\"row\" data-kid=\"1-1-3-2-2-1\" data-name=\"conversation row button\" type=\"button\"><span class=\"name\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"conversation title text\">Security incident notice windows</span></button></li>\n<li data-kid=\"1-1-3-2-3\" data-name=\"conversation list item\"><button class=\"row\" data-kid=\"1-1-3-2-3-1\" data-name=\"conversation row button\" type=\"button\"><span class=\"name\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"conversation title text\">Data retention obligations</span></button></li>\n</ul>\n<button class=\"show-all\" data-kid=\"1-1-3-3\" data-name=\"show all conversations button\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-3-1\" data-name=\"show all chevron icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-3-1-1\" data-lucide=\"chevron-right\" data-name=\"chevron right icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>Show all 8</button>\n<div class=\"docs\" data-kid=\"1-1-3-4\" data-name=\"documents section container\">\n<button aria-expanded=\"true\" class=\"section-label\" data-kid=\"1-1-3-4-1\" data-name=\"documents section header\" type=\"button\">\n<span class=\"chev\" data-kid=\"1-1-3-4-1-1\" data-name=\"section collapse chevron wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-1-1-1\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>\n<span class=\"label\" data-kid=\"1-1-3-4-1-2\" data-name=\"section label text\">Documents</span>\n<span class=\"count\" data-kid=\"1-1-3-4-1-3\" data-name=\"documents count badge\">6</span>\n</button>\n<div class=\"search\" data-kid=\"1-1-3-4-2\" data-name=\"document search container\">\n<span class=\"icon\" data-kid=\"1-1-3-4-2-1\" data-name=\"search icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-2-1-1\" data-lucide=\"search\" data-name=\"search magnifier icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>\n<input aria-label=\"Search documents\" data-kid=\"1-1-3-4-2-2\" data-name=\"document search input field\" placeholder=\"Search documents\" type=\"search\"/>\n</div>\n<ul class=\"rows\" data-kid=\"1-1-3-4-3\" data-name=\"documents list\">\n<li data-kid=\"1-1-3-4-3-1\" data-name=\"document list item\"><button class=\"row row-doc\" data-kid=\"1-1-3-4-3-1-1\" data-name=\"document row button\" title=\"Cascade-MSA-2027.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-3-1-1-1\" data-name=\"document file icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-3-1-1-1-1\" data-lucide=\"file-text\" data-name=\"document file icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span><span class=\"name\" data-dynamic=\"true\" data-kid=\"1-1-3-4-3-1-1-2\" data-name=\"document file name\" data-reason=\"false\">Cascade-MSA-2027.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-3-1-1-3\" data-name=\"document page count badge\">24</span></button></li>\n<li data-kid=\"1-1-3-4-3-2\" data-name=\"document list item\"><button class=\"row row-doc\" data-kid=\"1-1-3-4-3-2-1\" data-name=\"document row button\" title=\"Data-Processing-Addendum.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-3-2-1-1\" data-name=\"document file icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-3-2-1-1-1\" data-lucide=\"file-text\" data-name=\"document file icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span><span class=\"name\" data-kid=\"1-1-3-4-3-2-1-2\" data-name=\"document file name text\">Data-Processing-Addendum.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-3-2-1-3\" data-name=\"document page count badge\">9</span></button></li>\n<li data-kid=\"1-1-3-4-3-3\" data-name=\"document list item\"><button class=\"row row-doc\" data-kid=\"1-1-3-4-3-3-1\" data-name=\"document row button\" title=\"Security-Review-Northwind.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-3-3-1-1\" data-name=\"document file icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-3-3-1-1-1\" data-lucide=\"file-text\" data-name=\"document file icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span><span class=\"name\" data-kid=\"1-1-3-4-3-3-1-2\" data-name=\"document file name text\">Security-Review-Northwind.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-3-3-1-3\" data-name=\"document page count badge\">14</span></button></li>\n<li data-kid=\"1-1-3-4-3-4\" data-name=\"document list item\"><button class=\"row row-doc\" data-kid=\"1-1-3-4-3-4-1\" data-name=\"document row button\" title=\"Vendor-Onboarding-Policy.md\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-3-4-1-1\" data-name=\"document file icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-3-4-1-1-1\" data-lucide=\"file-text\" data-name=\"document file icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span><span class=\"name\" data-kid=\"1-1-3-4-3-4-1-2\" data-name=\"document file name text\">Vendor-Onboarding-Policy.md</span><span class=\"pages\" data-kid=\"1-1-3-4-3-4-1-3\" data-name=\"document page count badge\">6</span></button></li>\n<li data-kid=\"1-1-3-4-3-5\" data-name=\"document list item\"><button class=\"row row-doc\" data-kid=\"1-1-3-4-3-5-1\" data-name=\"document row button\" title=\"SLA-Cloud-Hosting-Addendum.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-3-5-1-1\" data-name=\"document file icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-3-5-1-1-1\" data-lucide=\"file-text\" data-name=\"document file icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span><span class=\"name\" data-kid=\"1-1-3-4-3-5-1-2\" data-name=\"document file name text\">SLA-Cloud-Hosting-Addendum.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-3-5-1-3\" data-name=\"document page count badge\">11</span></button></li>\n<li data-kid=\"1-1-3-4-3-6\" data-name=\"document list item\"><button class=\"row row-doc\" data-kid=\"1-1-3-4-3-6-1\" data-name=\"document row button\" title=\"Insurance-Certificate-2026.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-3-6-1-1\" data-name=\"document file icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-3-6-1-1-1\" data-lucide=\"file-text\" data-name=\"document file icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span><span class=\"name\" data-kid=\"1-1-3-4-3-6-1-2\" data-name=\"document file name text\">Insurance-Certificate-2026.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-3-6-1-3\" data-name=\"document page count badge\">2</span></button></li>\n</ul>\n<button class=\"add-docs\" data-kid=\"1-1-3-4-4\" data-name=\"add documents button\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-4-1\" data-name=\"add documents upload icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-1-3-4-4-1-1\" data-lucide=\"upload\" data-name=\"upload icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>Add documents</button>\n</div>\n</nav>\n</aside>\n<main class=\"main\" data-kid=\"1-2\" data-name=\"main conversation panel\">\n<header class=\"thread-head\" data-kid=\"1-2-1\" data-name=\"conversation thread header\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"thread title heading\">Liability cap in Cascade MSA</h1>\n</header>\n<div class=\"thread\" data-kid=\"1-2-2\" data-name=\"conversation thread scroll area\">\n<div class=\"thread-inner\" data-kid=\"1-2-2-1\" data-name=\"thread content container\">\n<article class=\"turn\" data-kid=\"1-2-2-1-1\" data-name=\"first exchange turn\">\n<div class=\"user-row\" data-kid=\"1-2-2-1-1-1\" data-name=\"user message row\"><div class=\"bubble\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"user message bubble\">What is the liability cap in the Cascade Systems MSA, and what does it exclude?</div></div>\n<div class=\"answer\" data-kid=\"1-2-2-1-1-2\" data-name=\"assistant answer block\">\n<p data-kid=\"1-2-2-1-1-2-1\" data-name=\"answer text paragraph\">The cap is the greater of the fees paid in the twelve months before the claim or USD 250,000, per Section 9.2<button aria-label=\"Source 1, Cascade-MSA-2027.pdf page 11\" class=\"cite\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"citation badge for source 1\" type=\"button\">1</button>. Three provisions narrow it: Section 9.3 excludes indirect and consequential damages<button aria-label=\"Source 2, Cascade-MSA-2027.pdf page 12\" class=\"cite\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"citation badge for source 2\" type=\"button\">2</button>, Section 9.4 excludes lost profits and lost data<button aria-label=\"Source 2, Cascade-MSA-2027.pdf page 12\" class=\"cite\" data-kid=\"1-2-2-1-1-2-1-3\" data-name=\"citation badge for source 2\" type=\"button\">2</button>, and Section 12.4 removes confidentiality breaches from the cap entirely, leaving them uncapped<button aria-label=\"Source 3, Cascade-MSA-2027.pdf page 19\" class=\"cite\" data-kid=\"1-2-2-1-1-2-1-4\" data-name=\"citation badge for source 3\" type=\"button\">3</button>.</p>\n</div>\n<div class=\"answer-foot\" data-kid=\"1-2-2-1-1-3\" data-name=\"answer footer actions bar\">\n<button class=\"foot-btn\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"sources count button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-1-3-1-1\" data-name=\"sources files icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-2-2-1-1-3-1-1-1\" data-lucide=\"files\" data-name=\"files icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>3 sources</button>\n<span class=\"foot-sep\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"footer action separator\"></span>\n<button class=\"foot-btn\" data-kid=\"1-2-2-1-1-3-3\" data-name=\"safety checks button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-1-3-3-1\" data-name=\"safety shield icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-2-2-1-1-3-3-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>Safety checks</button>\n<span class=\"foot-sep\" data-kid=\"1-2-2-1-1-3-4\" data-name=\"footer action separator\"></span>\n<span class=\"conf-tag\" data-kid=\"1-2-2-1-1-3-5\" data-name=\"confidence level tag\">Medium confidence</span>\n</div>\n</article>\n<article class=\"turn\" data-kid=\"1-2-2-1-2\" data-name=\"second exchange turn\">\n<div class=\"user-row\" data-kid=\"1-2-2-1-2-1\" data-name=\"user message row\"><div class=\"bubble\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"user message bubble\">Which of those came from the 14 March redline?</div></div>\n<div class=\"answer\" data-kid=\"1-2-2-1-2-2\" data-name=\"assistant answer block\">\n<p data-kid=\"1-2-2-1-2-2-1\" data-name=\"answer text paragraph\">Section 12.4 was added in the 14 March redline at page 19. Sections 9.2 to 9.4 are unchanged from the 6 February draft<button aria-label=\"Source 1, Cascade-MSA-2027.pdf page 19\" class=\"cite\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"citation badge for source 1\" type=\"button\">1</button>.</p>\n</div>\n<div class=\"answer-foot\" data-kid=\"1-2-2-1-2-3\" data-name=\"answer footer actions bar\">\n<button class=\"foot-btn\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"sources count button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"sources files icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1-1-1\" data-lucide=\"files\" data-name=\"files icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>1 source</button>\n<span class=\"foot-sep\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"footer action separator\"></span>\n<button class=\"foot-btn\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"safety checks button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-2-3-3-1\" data-name=\"safety shield icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-3-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span>Safety checks</button>\n</div>\n</article>\n</div>\n</div>\n<div class=\"composer\" data-kid=\"1-2-3\" data-name=\"message composer section\">\n<div class=\"composer-inner\" data-kid=\"1-2-3-1\" data-name=\"composer inner container\">\n<form class=\"field\" data-kid=\"1-2-3-1-1\" data-name=\"question input field container\" onsubmit=\"return false\">\n<button aria-label=\"Add documents\" class=\"attach\" data-kid=\"1-2-3-1-1-1\" data-name=\"attach documents button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"paperclip icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-2-3-1-1-1-1-1\" data-lucide=\"paperclip\" data-name=\"paperclip icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span></button>\n<textarea aria-label=\"Ask a question about these documents\" data-kid=\"1-2-3-1-1-2\" data-name=\"question text input area\" placeholder=\"Ask about the Cascade MSA…\" rows=\"1\"></textarea>\n<button aria-label=\"Send question\" class=\"send\" data-kid=\"1-2-3-1-1-3\" data-name=\"send question button\" disabled=\"\" type=\"submit\"><span class=\"icon\" data-kid=\"1-2-3-1-1-3-1\" data-name=\"send arrow icon wrapper\"><i data-dynamic=\"true\" data-kid=\"1-2-3-1-1-3-1-1\" data-lucide=\"arrow-up\" data-name=\"arrow up icon\" data-reason=\"lucide.createIcons() replaces this placeholder with an SVG\"></i></span></button>\n</form>\n</div>\n</div>\n</main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/lucide@0.454.0/dist/umd/lucide.min.js\"></script>\n<script>if (window.lucide) lucide.createIcons();</script>",
