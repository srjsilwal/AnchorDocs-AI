      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Lato:wght@400;700&display=swap');\n\n:root{\n  --ink:#15181c;\n  --ink-2:#40464e;\n  --muted:#717a85;\n  --line:#e5e5df;\n  --line-strong:#d6d6cf;\n  --paper:#ffffff;\n  --rail:#f7f7f4;\n  --rail-hover:#ecece6;\n  --rail-active:#e6e6df;\n  --accent:#14544d;\n  --accent-soft:#edf4f2;\n  --warn:#8a5400;\n  --warn-soft:#fdf6e9;\n}\n*{box-sizing:border-box}\nhtml,body{height:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:'Archivo',system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}\nbutton{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}\nbutton:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\ni[data-lucide]{display:inline-flex}\n.icon{display:inline-flex;align-items:center;justify-content:center;flex:none}\n.icon svg{width:16px;height:16px;stroke-width:1.75}\n\n.app{display:flex;height:100vh;overflow:hidden}\n\n/* ============ sidebar ============ */\n.sidebar{width:248px;flex:none;display:flex;flex-direction:column;background:var(--rail);border-right:1px solid var(--line);padding:0 12px 14px;overflow:hidden}\n.ws-block{height:72px;flex:none;display:flex;flex-direction:column;justify-content:center;gap:4px;padding:0 4px}\n.brand{display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:600;letter-spacing:-.01em;color:var(--ink);text-decoration:none}\n.mark{width:26px;height:26px;border-radius:7px;background:var(--ink);color:#fff;display:grid;place-items:center}\n.mark svg{width:15px;height:15px;stroke-width:1.9}\n.ws-name{display:flex;align-items:center;gap:3px;margin-left:35px;font-size:12.5px;font-weight:500;color:var(--muted);height:18px}\n.ws-name:hover{color:var(--ink)}\n.ws-name svg{width:12px;height:12px;stroke-width:2.2}\n.new-chat{display:flex;align-items:center;gap:9px;height:40px;flex:none;padding:0 11px;border-radius:8px;border:1px solid var(--line-strong);background:#fff;font-size:13.5px;font-weight:500;color:var(--ink);width:100%;margin-top:4px}\n.new-chat:hover{background:#fcfcfa;border-color:#c3c6bd}\n.new-chat svg{width:15px;height:15px;stroke-width:2}\n.nav{flex:1;min-height:0;overflow-y:auto;padding-top:20px;display:flex;flex-direction:column}\n.nav::-webkit-scrollbar{width:0}\n.group-head{display:flex;align-items:center;justify-content:space-between;height:26px;padding:0 10px;margin-bottom:3px;font-size:11.5px;font-weight:600;letter-spacing:.045em;text-transform:uppercase;color:#8b939c}\n.group-head .n{font-size:11.5px;letter-spacing:0;color:var(--muted)}\n.list{list-style:none;margin:0 0 18px;padding:0;display:flex;flex-direction:column;gap:1px}\n.list:last-of-type{margin-bottom:4px}\n.row{display:flex;align-items:center;gap:9px;width:100%;height:36px;padding:0 10px;border-radius:7px;text-align:left;font-size:13px;color:var(--ink-2)}\n.row:hover{background:var(--rail-hover);color:var(--ink)}\n.row.is-active{background:var(--rail-active);color:var(--ink);font-weight:500}\n.row .t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.row .pages{flex:none;font-size:12px;color:var(--muted)}\n.row .icon svg{width:15px;height:15px;stroke-width:1.6;color:var(--muted)}\n.row.is-active .icon svg{color:var(--ink-2)}\n.add-docs{display:flex;align-items:center;gap:9px;width:100%;height:36px;padding:0 10px;margin-top:1px;border-radius:7px;font-size:13px;font-weight:500;color:var(--ink-2)}\n.add-docs:hover{background:var(--rail-hover);color:var(--ink)}\n.add-docs svg{width:15px;height:15px;stroke-width:1.8}\n\n/* ============ main ============ */\n.main{flex:1;min-width:0;display:flex;flex-direction:column}\n.thread-head{height:72px;flex:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 16px 0 31px;border-bottom:1px solid var(--line);background:var(--paper)}\n.thread-head h1{margin:0;font-size:15px;font-weight:600;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.head-tools{display:flex;align-items:center;gap:2px}\n.icon-btn{width:34px;height:34px;border-radius:7px;display:grid;place-items:center;color:var(--muted)}\n.icon-btn:hover{background:#f3f3ef;color:var(--ink)}\n.icon-btn svg{width:17px;height:17px;stroke-width:1.7}\n.main-body{flex:1;min-height:0;display:flex}\n\n/* chat column */\n.chat-col{flex:1;min-width:0;display:flex;flex-direction:column;background:var(--paper)}\n.thread{flex:1;min-height:0;overflow-y:auto}\n.thread::-webkit-scrollbar{width:10px}\n.thread::-webkit-scrollbar-thumb{background:#e3e3dd;border:3px solid #fff;border-radius:8px}\n.thread-inner{max-width:744px;margin:0 auto;padding:26px 31px 8px}\n.user-row{display:flex;justify-content:flex-end;margin-bottom:24px}\n.bubble{max-width:520px;padding:9px 15px;border-radius:15px 15px 4px 15px;background:#f1f1ec;font-family:'Lato';font-size:15px;line-height:1.52;color:#1c2025}\n.turn{margin-bottom:26px;padding:2px 0 0}\n.answer{font-family:'Lato';font-size:16px;line-height:1.62;color:#20242a}\n.answer p{margin:0 0 14px}\n.answer p:last-child{margin-bottom:0}\n.cite{display:inline-flex;align-items:center;justify-content:center;min-width:17px;height:17px;padding:0 4px;margin:0 2px 0 3px;border-radius:4px;background:var(--accent-soft);color:var(--accent);font-family:'Archivo';font-size:11px;font-weight:600;line-height:1;vertical-align:1.5px;border:1px solid transparent;transition:background .12s ease,color .12s ease}\n.cite:hover{border-color:#b3cbc6}\n.cite.is-selected{background:var(--accent);border-color:var(--accent);color:#fff}\n.answer-foot{display:flex;align-items:center;gap:2px;height:40px;margin-top:6px}\n.foot-btn{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 8px;border-radius:6px;font-size:12.5px;font-weight:500;color:var(--muted)}\n.foot-btn:hover{background:#f4f4f0;color:var(--ink)}\n.foot-btn svg{width:14px;height:14px;stroke-width:1.8}\n.foot-btn.is-open{background:#f4f4f0;color:var(--ink)}\n.foot-sep{width:1px;height:13px;background:var(--line-strong);margin:0 3px}\n\n/* composer */\n.composer{flex:none;padding:10px 31px 16px;background:var(--paper)}\n.composer-inner{max-width:744px;margin:0 auto}\n.field{display:flex;align-items:flex-end;gap:8px;height:76px;padding:10px;border:1px solid var(--line-strong);border-radius:14px;background:#fff;box-shadow:0 1px 2px rgba(20,24,28,.04)}\n.field:focus-within{border-color:#9aadaa;box-shadow:0 0 0 3px rgba(20,84,77,.08)}\n.attach{width:32px;height:32px;border-radius:7px;display:grid;place-items:center;color:var(--muted);flex:none;margin-bottom:6px}\n.attach:hover{background:#f3f3ef;color:var(--ink)}\n.attach svg{width:17px;height:17px;stroke-width:1.7}\n.field textarea{flex:1;height:54px;padding:8px 2px;border:0;outline:0;resize:none;background:transparent;font-family:'Lato';font-size:15px;line-height:1.5;color:var(--ink)}\n.field textarea::placeholder{color:#8b939b}\n.send{width:44px;height:44px;flex:none;border-radius:10px;display:grid;place-items:center;background:var(--ink);color:#fff;margin-bottom:6px}\n.send:hover{background:#000}\n.send svg{width:19px;height:19px;stroke-width:2}\n\n/* ============ sources slide-over ============ */\n.drawer{width:448px;flex:none;display:flex;flex-direction:column;background:#fff;border-left:1px solid var(--line);box-shadow:-18px 0 40px -34px rgba(16,24,40,.35)}\n.drawer-head{height:64px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 14px 0 20px;border-bottom:1px solid var(--line)}\n.drawer-title{display:flex;align-items:baseline;gap:8px}\n.drawer-title h2{margin:0;font-size:14.5px;font-weight:600;letter-spacing:-.005em}\n.drawer-title .n{font-size:12.5px;font-weight:400;color:var(--muted)}\n.close{width:30px;height:30px;border-radius:6px;display:grid;place-items:center;color:var(--muted)}\n.close:hover{background:#f2f2ee;color:var(--ink)}\n.close svg{width:17px;height:17px;stroke-width:1.9}\n.drawer-body{flex:1;min-height:0;overflow-y:auto;padding:20px 20px 24px}\n.drawer-body::-webkit-scrollbar{width:10px}\n.drawer-body::-webkit-scrollbar-thumb{background:#e3e3dd;border:3px solid #fff;border-radius:8px}\n.index-label{display:flex;align-items:center;justify-content:space-between;margin:0 0 6px 2px;font-size:11.5px;font-weight:600;letter-spacing:.045em;text-transform:uppercase;color:#8b939c}\n.index{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}\n.idx-row{display:flex;align-items:flex-start;gap:10px;width:100%;min-height:44px;padding:7px 9px;border-radius:7px;text-align:left}\n.idx-row:hover{background:#f5f5f1}\n.idx-row .num{display:grid;place-items:center;min-width:19px;height:19px;margin-top:1px;border-radius:4px;background:var(--accent-soft);color:var(--accent);font-size:11px;font-weight:600;flex:none}\n.idx-row .body-txt{min-width:0;flex:1}\n.idx-row .name{display:block;font-size:13px;font-weight:500;line-height:1.4;color:var(--ink);word-break:break-word}\n.idx-row .loc{display:block;margin-top:1px;font-size:12px;color:var(--muted)}\n.idx-row.is-selected{background:var(--accent-soft)}\n.idx-row.is-selected .num{background:var(--accent);color:#fff}\n.idx-row.is-selected .name{font-weight:600}\n\n.passage{margin-top:20px;border-top:1px solid var(--line);padding-top:18px}\n.passage-head{display:flex;align-items:flex-start;gap:10px;padding-bottom:12px}\n.passage-head .icon svg{width:18px;height:18px;stroke-width:1.7;color:var(--ink-2);margin-top:1px}\n.passage-file{font-size:14px;font-weight:600;line-height:1.35;color:var(--ink);word-break:break-word}\n.passage-meta{margin-top:2px;font-size:12.5px;color:var(--muted)}\n.quote{margin:0 0 14px;padding-left:14px;border-left:2px solid #bcd4ce;font-family:'Lato';font-size:15px;line-height:1.62;color:#252a30}\n.excerpt{margin:0;padding:13px 14px;border:1px solid var(--line);border-radius:9px;background:#f8f8f5;font-family:'Lato';font-size:13.5px;line-height:1.68;color:#3c424a}\n.excerpt strong{font-family:'Archivo';font-size:12.5px;font-weight:600;letter-spacing:.01em;color:#252a30}\n\n.safety{margin-top:22px;border-top:1px solid var(--line);padding-top:16px}\n.safety-head{display:flex;align-items:center;justify-content:space-between;width:100%;height:28px;margin-bottom:8px}\n.safety-head .label{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--ink)}\n.safety-head .label svg{width:15px;height:15px;stroke-width:1.8;color:var(--ink-2)}\n.safety-head .chev{color:var(--muted);display:inline-flex}\n.safety-head .chev svg{width:15px;height:15px;stroke-width:1.9}\n.rows{margin:0;display:grid;grid-template-columns:88px 1fr;row-gap:0}\n.rows dt{margin:0;padding:7px 0;font-size:12.5px;color:var(--muted);border-top:1px solid #f0f0ec}\n.rows dd{margin:0;padding:7px 0;font-size:12.5px;line-height:1.55;color:var(--ink-2);border-top:1px solid #f0f0ec}\n.conf{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:#6b5312}\n.conf:before{content:\"\";width:5px;height:5px;border-radius:50%;background:#b4881f}\n.note{margin-top:10px;padding:10px 12px;border-radius:8px;background:var(--warn-soft);border:1px solid #f0e3c4;font-family:'Lato';font-size:12.5px;line-height:1.55;color:#5f4410}\n.drawer-foot{height:56px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 20px;border-top:1px solid var(--line)}\n.open-doc{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:7px;border:1px solid var(--line-strong);font-size:12.5px;font-weight:500;color:var(--ink);background:#fff}\n.open-doc:hover{background:#f6f6f2}\n.open-doc svg{width:14px;height:14px;stroke-width:1.8;color:var(--muted)}\n.foot-page{font-size:12px;color:var(--muted)}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout container\">\n<aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"workspace sidebar\">\n<div class=\"ws-block\" data-kid=\"1-1-1\" data-name=\"workspace identity block\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"product brand link\" href=\"#\"><span class=\"mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo mark\"><span class=\"icon\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon wrapper\"><i data-kid=\"1-1-1-1-1-1-1\" data-lucide=\"file-text\" data-name=\"document logo icon\"></i></span></span>AnchorDocs</a>\n<button aria-label=\"Switch workspace\" class=\"ws-name\" data-kid=\"1-1-1-2\" data-name=\"workspace switcher button\" type=\"button\">Procurement<i data-kid=\"1-1-1-2-1\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\"></i></button>\n</div>\n<button class=\"new-chat\" data-kid=\"1-1-2\" data-name=\"new chat button\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-2-1\" data-name=\"plus icon wrapper\"><i data-kid=\"1-1-2-1-1\" data-lucide=\"plus\" data-name=\"plus icon\"></i></span>New chat</button>\n<nav aria-label=\"Workspace navigation\" class=\"nav\" data-kid=\"1-1-3\" data-name=\"workspace navigation\">\n<div class=\"group-head\" data-kid=\"1-1-3-1\" data-name=\"group heading: recent conversations\">Recent conversations</div>\n<ul class=\"list\" data-kid=\"1-1-3-2\" data-name=\"recent conversations list\">\n<li data-kid=\"1-1-3-2-1\" data-name=\"recent conversation list item\"><button aria-current=\"page\" class=\"row is-active\" data-kid=\"1-1-3-2-1-1\" data-name=\"active conversation row\" type=\"button\"><span class=\"t\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"conversation title text\">Liability cap in Cascade MSA</span></button></li>\n<li data-kid=\"1-1-3-2-2\" data-name=\"recent conversation list item\"><button class=\"row\" data-kid=\"1-1-3-2-2-1\" data-name=\"conversation row button\" type=\"button\"><span class=\"t\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"conversation title text\">Security incident notice windows</span></button></li>\n<li data-kid=\"1-1-3-2-3\" data-name=\"recent conversation list item\"><button class=\"row\" data-kid=\"1-1-3-2-3-1\" data-name=\"conversation row button\" type=\"button\"><span class=\"t\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"conversation title text\">Data retention obligations</span></button></li>\n<li data-kid=\"1-1-3-2-4\" data-name=\"recent conversation list item\"><button class=\"row\" data-kid=\"1-1-3-2-4-1\" data-name=\"conversation row button\" type=\"button\"><span class=\"t\" data-kid=\"1-1-3-2-4-1-1\" data-name=\"conversation title text\">Vendor approval steps</span></button></li>\n<li data-kid=\"1-1-3-2-5\" data-name=\"recent conversation list item\"><button class=\"row\" data-kid=\"1-1-3-2-5-1\" data-name=\"conversation row button\" type=\"button\"><span class=\"t\" data-kid=\"1-1-3-2-5-1-1\" data-name=\"conversation title text\">Indemnity and limitation of liability</span></button></li>\n<li data-kid=\"1-1-3-2-6\" data-name=\"recent conversation list item\"><button class=\"row\" data-kid=\"1-1-3-2-6-1\" data-name=\"conversation row button\" type=\"button\"><span class=\"t\" data-kid=\"1-1-3-2-6-1-1\" data-name=\"conversation title text\">Subprocessor list for Northwind</span></button></li>\n</ul>\n<div class=\"group-head\" data-kid=\"1-1-3-3\" data-name=\"group heading: documents\">Documents<span class=\"n\" data-kid=\"1-1-3-3-1\" data-name=\"document count badge\">4</span></div>\n<ul class=\"list\" data-kid=\"1-1-3-4\" data-name=\"documents list\">\n<li data-kid=\"1-1-3-4-1\" data-name=\"document list item\"><button class=\"row\" data-kid=\"1-1-3-4-1-1\" data-name=\"document row button\" title=\"Cascade-MSA-2027.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-1-1-1\" data-name=\"document icon wrapper\"><i data-kid=\"1-1-3-4-1-1-1-1\" data-lucide=\"file-text\" data-name=\"document icon\"></i></span><span class=\"t\" data-kid=\"1-1-3-4-1-1-2\" data-name=\"document file name\">Cascade-MSA-2027.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-1-1-3\" data-name=\"document page count\">24</span></button></li>\n<li data-kid=\"1-1-3-4-2\" data-name=\"document list item\"><button class=\"row\" data-kid=\"1-1-3-4-2-1\" data-name=\"document row button\" title=\"Data-Processing-Addendum.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-2-1-1\" data-name=\"document icon wrapper\"><i data-kid=\"1-1-3-4-2-1-1-1\" data-lucide=\"file-text\" data-name=\"document icon\"></i></span><span class=\"t\" data-kid=\"1-1-3-4-2-1-2\" data-name=\"document file name\">Data-Processing-Addendum.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-2-1-3\" data-name=\"document page count\">9</span></button></li>\n<li data-kid=\"1-1-3-4-3\" data-name=\"document list item\"><button class=\"row\" data-kid=\"1-1-3-4-3-1\" data-name=\"document row button\" title=\"Security-Review-Northwind.pdf\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-3-1-1\" data-name=\"document icon wrapper\"><i data-kid=\"1-1-3-4-3-1-1-1\" data-lucide=\"file-text\" data-name=\"document icon\"></i></span><span class=\"t\" data-kid=\"1-1-3-4-3-1-2\" data-name=\"document file name\">Security-Review-Northwind.pdf</span><span class=\"pages\" data-kid=\"1-1-3-4-3-1-3\" data-name=\"document page count\">14</span></button></li>\n<li data-kid=\"1-1-3-4-4\" data-name=\"document list item\"><button class=\"row\" data-kid=\"1-1-3-4-4-1\" data-name=\"document row button\" title=\"Vendor-Onboarding-Policy.md\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-4-4-1-1\" data-name=\"document icon wrapper\"><i data-kid=\"1-1-3-4-4-1-1-1\" data-lucide=\"file-text\" data-name=\"document icon\"></i></span><span class=\"t\" data-kid=\"1-1-3-4-4-1-2\" data-name=\"document file name\">Vendor-Onboarding-Policy.md</span><span class=\"pages\" data-kid=\"1-1-3-4-4-1-3\" data-name=\"document page count\">6</span></button></li>\n</ul>\n<button class=\"add-docs\" data-kid=\"1-1-3-5\" data-name=\"add documents button\" type=\"button\"><span class=\"icon\" data-kid=\"1-1-3-5-1\" data-name=\"upload icon wrapper\"><i data-kid=\"1-1-3-5-1-1\" data-lucide=\"upload\" data-name=\"upload icon\"></i></span>Add documents</button>\n</nav>\n</aside>\n<div class=\"main\" data-kid=\"1-2\" data-name=\"main content area\">\n<header class=\"thread-head\" data-kid=\"1-2-1\" data-name=\"thread header bar\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"thread title heading\">Liability cap in Cascade MSA</h1>\n<div class=\"head-tools\" data-kid=\"1-2-1-2\" data-name=\"header tool buttons\">\n<button aria-label=\"Hide sources panel\" class=\"icon-btn\" data-kid=\"1-2-1-2-1\" data-name=\"hide sources panel button\" type=\"button\"><i data-kid=\"1-2-1-2-1-1\" data-lucide=\"panel-right\" data-name=\"panel right icon\"></i></button>\n</div>\n</header>\n<div class=\"main-body\" data-kid=\"1-2-2\" data-name=\"main body with chat and drawer\">\n<div class=\"chat-col\" data-kid=\"1-2-2-1\" data-name=\"chat column\">\n<div class=\"thread\" data-kid=\"1-2-2-1-1\" data-name=\"thread scroll container\">\n<div class=\"thread-inner\" data-kid=\"1-2-2-1-1-1\" data-name=\"thread content wrapper\">\n<div class=\"user-row\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"user message row\"><div class=\"bubble\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"user message bubble\">What is the liability cap in the Cascade Systems MSA, and what does it exclude?</div></div>\n<article class=\"turn\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"assistant response turn\">\n<div class=\"answer\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"assistant answer text container\">\n<p data-kid=\"1-2-2-1-1-1-2-1-1\" data-name=\"answer paragraph with citations\">The cap is the greater of the fees paid in the twelve months before the claim or USD 250,000, per Section 9.2<button aria-label=\"Citation 1, Cascade-MSA-2027.pdf page 11\" class=\"cite\" data-kid=\"1-2-2-1-1-1-2-1-1-1\" data-name=\"citation number 1 badge\" type=\"button\">1</button>. Three provisions narrow it: Section 9.3 excludes indirect and consequential damages<button aria-label=\"Citation 2, Cascade-MSA-2027.pdf page 12, selected\" class=\"cite is-selected\" data-kid=\"1-2-2-1-1-1-2-1-1-2\" data-name=\"selected citation number 2 badge\" type=\"button\">2</button>, Section 9.4 excludes lost profits and lost data<button aria-label=\"Citation 2, Cascade-MSA-2027.pdf page 12, selected\" class=\"cite is-selected\" data-kid=\"1-2-2-1-1-1-2-1-1-3\" data-name=\"selected citation number 2 badge\" type=\"button\">2</button>, and Section 12.4 removes confidentiality breaches from the cap entirely, leaving them uncapped<button aria-label=\"Citation 3, Cascade-MSA-2027.pdf page 19\" class=\"cite\" data-kid=\"1-2-2-1-1-1-2-1-1-4\" data-name=\"citation number 3 badge\" type=\"button\">3</button>.</p>\n</div>\n<div class=\"answer-foot\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"answer footer toolbar\">\n<button class=\"foot-btn is-open\" data-kid=\"1-2-2-1-1-1-2-2-1\" data-name=\"sources count toggle button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-1-1-2-2-1-1\" data-name=\"file icon wrapper\"><i data-kid=\"1-2-2-1-1-1-2-2-1-1-1\" data-lucide=\"file-text\" data-name=\"file text icon\"></i></span>3 sources</button>\n<span class=\"foot-sep\" data-kid=\"1-2-2-1-1-1-2-2-2\" data-name=\"footer separator line\"></span>\n<button class=\"foot-btn\" data-kid=\"1-2-2-1-1-1-2-2-3\" data-name=\"safety checks toggle button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-1-1-2-2-3-1\" data-name=\"shield icon wrapper\"><i data-kid=\"1-2-2-1-1-1-2-2-3-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\"></i></span>Safety checks</button>\n</div>\n</article>\n<div class=\"user-row\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"user message row\"><div class=\"bubble\" data-kid=\"1-2-2-1-1-1-3-1\" data-name=\"user message bubble\">Which of those came from the 14 March redline?</div></div>\n<article class=\"turn\" data-kid=\"1-2-2-1-1-1-4\" data-name=\"assistant response turn\">\n<div class=\"answer\" data-kid=\"1-2-2-1-1-1-4-1\" data-name=\"assistant answer text container\">\n<p data-kid=\"1-2-2-1-1-1-4-1-1\" data-name=\"answer paragraph with citation\">Section 12.4 was added in the 14 March redline at page 19. Sections 9.2 to 9.4 are unchanged from the 6 February draft<button aria-label=\"Citation 1, Cascade-MSA-2027.pdf page 11\" class=\"cite\" data-kid=\"1-2-2-1-1-1-4-1-1-1\" data-name=\"citation number 1 badge\" type=\"button\">1</button>.</p>\n</div>\n<div class=\"answer-foot\" data-kid=\"1-2-2-1-1-1-4-2\" data-name=\"answer footer toolbar\">\n<button class=\"foot-btn\" data-kid=\"1-2-2-1-1-1-4-2-1\" data-name=\"source count toggle button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-1-1-4-2-1-1\" data-name=\"file icon wrapper\"><i data-kid=\"1-2-2-1-1-1-4-2-1-1-1\" data-lucide=\"file-text\" data-name=\"file text icon\"></i></span>1 source</button>\n<span class=\"foot-sep\" data-kid=\"1-2-2-1-1-1-4-2-2\" data-name=\"footer separator line\"></span>\n<button class=\"foot-btn\" data-kid=\"1-2-2-1-1-1-4-2-3\" data-name=\"safety checks toggle button\" type=\"button\"><span class=\"icon\" data-kid=\"1-2-2-1-1-1-4-2-3-1\" data-name=\"shield icon wrapper\"><i data-kid=\"1-2-2-1-1-1-4-2-3-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\"></i></span>Safety checks</button>\n</div>\n</article>\n</div>\n</div>\n<div class=\"composer\" data-kid=\"1-2-2-1-2\" data-name=\"composer section\">\n<div class=\"composer-inner\" data-kid=\"1-2-2-1-2-1\" data-name=\"composer inner wrapper\">\n<form class=\"field\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"composer input field\" onsubmit=\"return false\">\n<button aria-label=\"Add documents\" class=\"attach\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"attach documents button\" type=\"button\"><i data-kid=\"1-2-2-1-2-1-1-1-1\" data-lucide=\"paperclip\" data-name=\"paperclip icon\"></i></button>\n<textarea aria-label=\"Ask about the Cascade MSA\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"message textarea input\" placeholder=\"Ask about the Cascade MSA…\" rows=\"2\"></textarea>\n<button aria-label=\"Send question\" class=\"send\" data-kid=\"1-2-2-1-2-1-1-3\" data-name=\"send message button\" type=\"submit\"><i data-kid=\"1-2-2-1-2-1-1-3-1\" data-lucide=\"arrow-up\" data-name=\"send arrow icon\"></i></button>\n</form>\n</div>\n</div>\n</div>\n<aside aria-label=\"Sources for the selected answer\" class=\"drawer\" data-kid=\"1-2-2-2\" data-name=\"sources slide-over drawer\">\n<div class=\"drawer-head\" data-kid=\"1-2-2-2-1\" data-name=\"drawer header\">\n<div class=\"drawer-title\" data-kid=\"1-2-2-2-1-1\" data-name=\"drawer title group\"><h2 data-kid=\"1-2-2-2-1-1-1\" data-name=\"drawer title heading\">Sources</h2><span class=\"n\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"citation count label\">3 citations</span></div>\n<button aria-label=\"Close sources\" class=\"close\" data-kid=\"1-2-2-2-1-2\" data-name=\"close drawer button\" type=\"button\"><i data-kid=\"1-2-2-2-1-2-1\" data-lucide=\"x\" data-name=\"close X icon\"></i></button>\n</div>\n<div class=\"drawer-body\" data-kid=\"1-2-2-2-2\" data-name=\"drawer scrollable body\">\n<div class=\"index-label\" data-kid=\"1-2-2-2-2-1\" data-name=\"citations label\">Citations</div>\n<ul class=\"index\" data-kid=\"1-2-2-2-2-2\" data-name=\"citations index list\">\n<li data-kid=\"1-2-2-2-2-2-1\" data-name=\"citation list item 1\">\n<button class=\"idx-row\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"citation row button\" type=\"button\">\n<span class=\"num\" data-kid=\"1-2-2-2-2-2-1-1-1\" data-name=\"citation number badge 1\">1</span>\n<span class=\"body-txt\" data-kid=\"1-2-2-2-2-2-1-1-2\" data-name=\"citation detail group\"><span class=\"name\" data-kid=\"1-2-2-2-2-2-1-1-2-1\" data-name=\"citation source file name\">Cascade-MSA-2027.pdf</span><span class=\"loc\" data-kid=\"1-2-2-2-2-2-1-1-2-2\" data-name=\"citation location info\">Page 11 · § 9.2</span></span>\n</button>\n</li>\n<li data-kid=\"1-2-2-2-2-2-2\" data-name=\"citation list item 2 (selected)\">\n<button aria-current=\"true\" class=\"idx-row is-selected\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"selected citation row button\" type=\"button\">\n<span class=\"num\" data-kid=\"1-2-2-2-2-2-2-1-1\" data-name=\"citation number badge 2\">2</span>\n<span class=\"body-txt\" data-kid=\"1-2-2-2-2-2-2-1-2\" data-name=\"citation detail group\"><span class=\"name\" data-kid=\"1-2-2-2-2-2-2-1-2-1\" data-name=\"citation source file name\">Cascade-MSA-2027.pdf</span><span class=\"loc\" data-kid=\"1-2-2-2-2-2-2-1-2-2\" data-name=\"citation location info\">Page 12 · §§ 9.3–9.4</span></span>\n</button>\n</li>\n<li data-kid=\"1-2-2-2-2-2-3\" data-name=\"citation list item 3\">\n<button class=\"idx-row\" data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"citation row button\" type=\"button\">\n<span class=\"num\" data-kid=\"1-2-2-2-2-2-3-1-1\" data-name=\"citation number badge 3\">3</span>\n<span class=\"body-txt\" data-kid=\"1-2-2-2-2-2-3-1-2\" data-name=\"citation detail group\"><span class=\"name\" data-kid=\"1-2-2-2-2-2-3-1-2-1\" data-name=\"citation source file name\">Cascade-MSA-2027.pdf</span><span class=\"loc\" data-kid=\"1-2-2-2-2-2-3-1-2-2\" data-name=\"citation location info\">Page 19 · § 12.4</span></span>\n</button>\n</li>\n</ul>\n<section class=\"passage\" data-kid=\"1-2-2-2-2-3\" data-name=\"source passage section\">\n<div class=\"passage-head\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"passage header with file info\">\n<span class=\"icon\" data-kid=\"1-2-2-2-2-3-1-1\" data-name=\"file icon wrapper\"><i data-kid=\"1-2-2-2-2-3-1-1-1\" data-lucide=\"file-text\" data-name=\"file text icon\"></i></span>\n<div data-kid=\"1-2-2-2-2-3-1-2\" data-name=\"passage file info group\">\n<div class=\"passage-file\" data-kid=\"1-2-2-2-2-3-1-2-1\" data-name=\"passage source file name\">Cascade-MSA-2027.pdf</div>\n<div class=\"passage-meta\" data-kid=\"1-2-2-2-2-3-1-2-2\" data-name=\"passage page and section meta\">Page 12 · §§ 9.3–9.4</div>\n</div>\n</div>\n<blockquote class=\"quote\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"quoted source text\">“In no event shall either party be liable for indirect, incidental, special, or consequential damages, or for loss of profits, revenue, or data, however caused.”</blockquote>\n<div class=\"excerpt\" data-kid=\"1-2-2-2-2-3-3\" data-name=\"excerpt card container\">\n<p data-kid=\"1-2-2-2-2-3-3-1\" data-name=\"section 9.3 excerpt paragraph\" style=\"margin:0\"><strong data-kid=\"1-2-2-2-2-3-3-1-1\" data-name=\"section number label 9.3\">9.3</strong> EXCLUSION OF CONSEQUENTIAL LOSSES. Except as set out in Section 9.5, neither party shall be liable to the other for any indirect or consequential loss arising out of or in connection with this Agreement.</p>\n<p data-kid=\"1-2-2-2-2-3-3-2\" data-name=\"section 9.4 excerpt paragraph\" style=\"margin:10px 0 0\"><strong data-kid=\"1-2-2-2-2-3-3-2-1\" data-name=\"section number label 9.4\">9.4</strong> LOST PROFITS AND DATA. Loss of profit, loss of revenue, loss of anticipated savings, and loss or corruption of data are excluded from either party’s liability.</p>\n</div>\n</section>\n<section class=\"safety\" data-kid=\"1-2-2-2-2-4\" data-name=\"safety checks section\">\n<button aria-expanded=\"true\" class=\"safety-head\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"safety checks toggle header button\" type=\"button\">\n<span class=\"label\" data-kid=\"1-2-2-2-2-4-1-1\" data-name=\"safety checks label\"><span class=\"icon\" data-kid=\"1-2-2-2-2-4-1-1-1\" data-name=\"shield icon wrapper\"><i data-kid=\"1-2-2-2-2-4-1-1-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\"></i></span>Safety checks</span>\n<span class=\"chev\" data-kid=\"1-2-2-2-2-4-1-2\" data-name=\"chevron up icon wrapper\"><i data-kid=\"1-2-2-2-2-4-1-2-1\" data-lucide=\"chevron-up\" data-name=\"chevron up icon\"></i></span>\n</button>\n<dl class=\"rows\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"safety checks definition list\">\n<dt data-kid=\"1-2-2-2-2-4-2-1\" data-name=\"confidence term\">Confidence</dt><dd data-kid=\"1-2-2-2-2-4-2-2\" data-name=\"confidence description cell\"><span class=\"conf\" data-kid=\"1-2-2-2-2-4-2-2-1\" data-name=\"confidence level indicator (medium)\">Medium</span></dd>\n<dt data-kid=\"1-2-2-2-2-4-2-3\" data-name=\"redaction term\">Redaction</dt><dd data-kid=\"1-2-2-2-2-4-2-4\" data-name=\"redaction description\">None applied</dd>\n</dl>\n<div class=\"note\" data-kid=\"1-2-2-2-2-4-3\" data-name=\"amendment warning note\">Section 9.2 was amended by the 14 March redline; the retrieved excerpt reflects the signed version.</div>\n</section>\n</div>\n<div class=\"drawer-foot\" data-kid=\"1-2-2-2-3\" data-name=\"drawer footer\">\n<button class=\"open-doc\" data-kid=\"1-2-2-2-3-1\" data-name=\"open document button\" type=\"button\"><i data-kid=\"1-2-2-2-3-1-1\" data-lucide=\"external-link\" data-name=\"external link icon\"></i>Open document</button>\n<span class=\"foot-page\" data-kid=\"1-2-2-2-3-2\" data-name=\"page position indicator\">Page 12 of 24</span>\n</div>\n</aside>\n</div>\n</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/lucide@0.454.0/dist/umd/lucide.min.js\"></script>\n<script>if (window.lucide) lucide.createIcons();</script>",
